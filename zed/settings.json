// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "inlay_hints": {
    "enabled": true
  },
  "terminal": {
    "font_family": ".ZedMono",
    "font_features": {
      "liga": false,
      "calt": false,
    },
  },
  "code_lens": "off",
  "which_key": {
    "enabled": true,
  },
  "buffer_font_family": ".ZedMono",
  "buffer_font_features": {
    "liga": false,
    "calt": false,
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "off",
        "reasoning_effort": "medium",
        "model": "auto",
      },
      "type": "registry",
    },
  },
  "languages": {
    "C++": {
      "inlay_hints": {
        "show_background": false,
        "show_value_hints": true,
        "enabled": true,
      },
      "format_on_save": "on",
    },
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "opencode",
      "model": "free/big-pickle",
      "enable_thinking": false,
    },
    "default_model": {
      "provider": "openai",
      "model": "gpt-5-mini",
      "enable_thinking": true,
      "effort": "medium",
    },
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "right",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
